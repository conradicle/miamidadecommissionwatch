{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?!www\\.)(?<city>[a-z0-9-]+)\\.miamidadecommissionwatch\\.com$"
        }
      ],
      "destination": "/city/index.html"
    },
    {
      "source": "/documents",
      "destination": "/documents/index.html"
    },
    {
      "source": "/documents/meeting-summaries",
      "destination": "/documents/meeting-summaries.html"
    },
    {
      "source": "/documents/agenda-summaries",
      "destination": "/documents/agenda-summaries.html"
    },
    {
      "source": "/documents/:type(meeting-summary|agenda-summary)/:date(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/documents/:type/:date.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/find-my-district.html",
      "destination": "/get-involved.html#find-district",
      "permanent": true
    },
    {
      "source": "/commissioners.html",
      "destination": "/officials.html",
      "permanent": true
    },
    {
      "source": "/constitutional-offices.html",
      "destination": "/officials.html",
      "permanent": true
    },
    {
      "source": "/editorials.html",
      "destination": "/news.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://www.gstatic.com https://translate.googleapis.com https://fonts.googleapis.com; img-src 'self' data: https://kpchirnlgjwdqducqdtx.supabase.co https://*.tile.openstreetmap.org https://unpkg.com https://www.gstatic.com https://fonts.gstatic.com https://translate.googleapis.com https://translate.google.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://kpchirnlgjwdqducqdtx.supabase.co https://translate.googleapis.com https://translate-pa.googleapis.com https://translate.google.com; frame-src 'self' https://translate.google.com https://translate.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
