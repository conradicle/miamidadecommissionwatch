# Miami-Dade Commission Watch -- environment variables
#
# Copy to .env.local for local work, and set the same names in the Vercel
# project under Settings > Environment Variables for deployments.
#
# NOTHING IN HERE IS A REAL VALUE. Never commit a filled-in copy: .gitignore
# ignores .env* precisely so a real one cannot be added by accident, and this
# file is the single exception.

# ---------- Supabase ----------
# Project URL and the SERVER-ONLY service role key. The service role key
# bypasses Row Level Security entirely, so it must never be sent to a browser:
# it is read only inside api/*.js, which run on Vercel's servers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# The publishable (anon) key is deliberately NOT here. It ships to the browser
# in js/supabase-client.js and is not a secret -- RLS is what protects the
# data, not the key. Keeping it in the client file rather than an env var is
# what lets this stay a static site with no build step.

# ---------- Resend ----------
# Transactional email: claim notifications, approval and denial notices,
# volunteer invites, and the subscriber digests in api/notify-subscribers.js.
# Free tier is 3,000 emails a month and 100 a day.
RESEND_API_KEY=re_replace_me

# Where claim requests are emailed. Cloudflare Email Routing handles mail on
# this domain, so this can be an address on the domain itself.
CLAIM_NOTIFICATION_EMAIL=you@example.com

# ---------- Feature flags ----------
# When false (the default), a city owner's invite to a volunteer editor goes
# out immediately. When true, it instead writes a pending row to city_invites
# for staff to approve in the dashboard.
#
# Anything other than the exact string "true" is read as false.
REQUIRE_STAFF_APPROVAL_FOR_INVITES=false

# ---------- Subdomain automation ----------
# Approving a claim creates the city's DNS record in Cloudflare and adds the
# domain in Vercel. Without these three, everything still works -- the city
# goes live in the database -- but its address has to be set up by hand and the
# dashboard says so.

# Cloudflare token scoped to THIS ZONE ONLY, with the single permission
# Zone > DNS > Edit. It can create the CNAME for a new city and nothing else:
# it cannot touch MX records, other zones, or the account.
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_ZONE_ID=replace_me

# Vercel token with access to this project, used to add <slug>.<domain> as a
# project domain. Vercel tokens are account-wide -- there is no per-project
# scope -- so treat it as sensitive and rotate it if it ever leaks.
VERCEL_API_TOKEN=replace_me

# Both default correctly for this project; set them only if it moves.
# VERCEL_PROJECT_ID=prj_5cHJwL6b0CypR2DztuZBgzY10pkc
# VERCEL_TEAM_ID=team_...

# The per-project CNAME target Vercel shows on a domain row. Only change this
# if Vercel gives the project a different one.
# CITY_DNS_TARGET=01e74edb75f50fad.vercel-dns-017.com

# ---------- X (Twitter) ----------
# Powers the "Latest from @MiamiDadeCW" panel under the seal on the homepage.
# Leave it unset and the panel shows a follow card instead: that is a
# supported state, not a broken one.
#
# It has to be a token because X retired the embedded profile timeline. The
# old <a class="twitter-timeline"> widget still loads and still renders a
# zero-height iframe for every account, so there is no free client-side way to
# show posts any more. Reading an account's posts means the v2 API, and reads
# start at the paid Basic tier -- the free tier can post but not read.
#
# Use an app-only Bearer Token from developer.x.com (Project > App > Keys and
# tokens), NOT the API key/secret pair. Read-only permissions are enough. The
# posts are fetched once per build by scripts/lib/x-feed.mjs, not per visit,
# so the panel costs two API reads per deploy.
X_BEARER_TOKEN=replace_me

# The account the panel reads. Defaults to MiamiDadeCW; set this only if the
# handle changes.
# X_HANDLE=MiamiDadeCW

# ---------- Email sender ----------
# Defaults to the address the newsletter already sends from, which is verified
# in Resend. Change only to another verified sender on the same domain.
# MAIL_FROM=Miami-Dade Commission Watch <news@miamidadecommissionwatch.com>
